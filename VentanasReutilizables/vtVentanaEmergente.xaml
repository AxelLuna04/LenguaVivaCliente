<Window x:Class="LenguaVivaCliente.VentanasReutilizables.vtVentanaEmergente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:LenguaVivaCliente.Properties"
        xmlns:local="clr-namespace:LenguaVivaCliente.VentanasReutilizables"
        mc:Ignorable="d"
        WindowState="Normal" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        AllowsTransparency="True"
        Title="" Height="770" Width="1200">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2ECC71"/>
            <Setter Property="Foreground" Value="#FF2D3436"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF58D68D"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Fill">
        <Grid Height="770" Width="1200">
            <Border CornerRadius="25" Background="#FF1E1E2E" Margin="304,265,304,267" BorderBrush="#FF3498DB" BorderThickness="2">
                <Grid Height="244" Width="594" Background="Transparent">
                    <!-- Título de la ventana emergente -->
                    <Label x:Name="lbTituloVentanaEmergente" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top" Foreground="#FFEDEDED" FontFamily="Pacifico, cursive" FontSize="32" Width="562" HorizontalContentAlignment="Center"/>

                    <!-- Descripción de la ventana emergente -->
                    <TextBlock x:Name="tbDescripcionVentanaEmergente" HorizontalAlignment="Center" Margin="20,80,20,0" VerticalAlignment="Top" Foreground="#FFB2B2B2" FontFamily="Segoe UI, sans-serif" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- Separador -->
                    <Separator Background="#FF3498DB" Margin="20,140,20,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="2"/>

                    <!-- Botón principal -->
                    <Button x:Name="btnPrincipalVentanaEmergente" Content="Aceptar" HorizontalAlignment="Center" Margin="0,0,0,20" VerticalAlignment="Bottom" Width="200" Height="40" Click="BtnAceptar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</Window>