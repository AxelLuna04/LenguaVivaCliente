<!-- vtSolicitarCorreo.xaml -->
<Window x:Class="LenguaVivaCliente.VentanasReutilizables.vtSolicitarCorreo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar correo" Height="200" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="20" Background="White" Padding="20" BorderBrush="#FF2ECC71" BorderThickness="2">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Ingrese el correo del alumno:" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox x:Name="TxtCorreo" Height="30" Margin="0,0,0,10"/>
            <Button Content="Aceptar" Width="100" HorizontalAlignment="Center" Click="Aceptar_Click"/>
        </StackPanel>
    </Border>
</Window>

