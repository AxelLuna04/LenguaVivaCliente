<Page x:Class="LenguaVivaCliente.Vistas.Reportes.vtHorarioProfesor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Reportes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Background="#FFF5F5F5"
      Title="Horario">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título mejorado -->
        <Border Grid.Row="0" Background="#FF8E44AD" CornerRadius="5" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="HORARIO" 
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>
        </Border>

        <!-- Tabla de horario mejorada -->
        <Border Grid.Row="1" BorderBrush="#FFBDBDBD" BorderThickness="1" CornerRadius="5" Background="White" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid Name="HorarioGrid" ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- Líneas de la cuadrícula -->
                    <Rectangle Grid.RowSpan="8" Grid.ColumnSpan="7" Stroke="#FFE0E0E0" StrokeThickness="1" Fill="Transparent"/>

                    <!-- Encabezados mejorados -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#FF8E44AD" BorderBrush="#FFBDBDBD" BorderThickness="0,0,1,1">
                        <TextBlock Text="Hora" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="#FF9B59B6" BorderBrush="#FFBDBDBD" BorderThickness="0,0,1,1">
                        <TextBlock Text="Lunes" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Background="#FF9B59B6" BorderBrush="#FFBDBDBD" BorderThickness="0,0,1,1">
                        <TextBlock Text="Martes" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="3" Background="#FF9B59B6" BorderBrush="#FFBDBDBD" BorderThickness="0,0,1,1">
                        <TextBlock Text="Miércoles" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="4" Background="#FF9B59B6" BorderBrush="#FFBDBDBD" BorderThickness="0,0,1,1">
                        <TextBlock Text="Jueves" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="5" Background="#FF9B59B6" BorderBrush="#FFBDBDBD" BorderThickness="0,0,1,1">
                        <TextBlock Text="Viernes" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="6" Background="#FF9B59B6" BorderBrush="#FFBDBDBD" BorderThickness="0,0,0,1">
                        <TextBlock Text="Sábado" Foreground="White" FontWeight="Bold" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>

                    <!-- Horas con diseño mejorado -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="07:00 - 09:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="09:00 - 11:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="11:00 - 13:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="13:00 - 15:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="15:00 - 17:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <Border Grid.Row="6" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,1">
                        <TextBlock Text="17:00 - 19:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <Border Grid.Row="7" Grid.Column="0" BorderBrush="#FFE0E0E0" BorderThickness="0,0,1,0">
                        <TextBlock Text="19:00 - 21:00" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextAlignment="Center" Margin="5" FontSize="12"/>
                    </Border>

                    <!-- Celdas de días (se llenarán dinámicamente) -->
                    <Rectangle Grid.Row="1" Grid.Column="1" Grid.RowSpan="7" Grid.ColumnSpan="6" 
                           Fill="White" Stroke="#FFE0E0E0" StrokeThickness="1"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Botón Descargar mejorado -->

        <!-- Botón de Regresar mejorado -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="Regresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
               FontSize="30" 
               Foreground="White" 
               FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF8E44AD"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                            CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9B59B6"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>


