<Page x:Class="LenguaVivaCliente.Vistas.Registros.vtRegistros"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Registros"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vtRegistros">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <Button Content="Registrar alumno" 
                    Width="200" 
                    Height="40" 
                    Margin="10"
                    FontSize="14"
                    Click="BtnAlumno_Click"/>

            <Button Content="Registrar administrador" 
                    Width="200" 
                    Height="40" 
                    Margin="10"
                    FontSize="14"
                    Click="BtnAdministrador_Click"/>

            <Button Content="Registrar profesor" 
                    Width="200" 
                    Height="40" 
                    Margin="10"
                    FontSize="14"
                    Click="BtnProfesor_Click"/>
        </StackPanel>
    </Grid>
</Page>