<Page x:Class="LenguaVivaCliente.Vistas.Registros.vtRegistroAdministrador"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Registros"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vtRegistroAdministrador">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Campos del formulario -->
        <Label Content="Nombre:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <Label Content="Apellidos:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <Label Content="Correo:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <Label Content="Dirección:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <Label Content="Teléfono:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <Label Content="Usuario:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <Label Content="Contraseña:" Grid.Row="6" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="6" Grid.Column="1" Margin="5" Width="250" HorizontalAlignment="Left"/>

        <!-- Botones -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Cancelar" 
                    Width="100" 
                    Height="30" 
                    Margin="10 0" 
                    Background="#FF4C4A" 
                    Foreground="White"
                    Cursor="Hand"
                    Padding="5"
                    Click="BtnCancelar_Click"/>

            <Button Content="Aceptar" 
                    Width="100" 
                    Height="30" 
                    Margin="10 0" 
                    Background="#4CAF50" 
                    Foreground="White"
                    Cursor="Hand"
                    Padding="5"
                    Click="BtnAceptar_Click"/>
        </StackPanel>
    </Grid>
</Page>