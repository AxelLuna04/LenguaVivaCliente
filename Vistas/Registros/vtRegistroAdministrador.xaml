<Page x:Class="LenguaVivaCliente.Vistas.Registros.vtRegistroAdministrador"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Registros"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="vtRegistroAdministrador"
      Background="#FF1E1E2E" Height="487">

    <Grid>
        <!-- Encabezado común -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF3498DB" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Registro de Administrador" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Contenedor del formulario -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Campo Nombre -->
            <Label Content="Nombre:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="0" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <TextBox x:Name="txtNombre" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbNombreVacio" Content="Campo obligatorio" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Campo Apellidos -->
            <Label Content="Apellidos:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <TextBox x:Name="txtApellidos" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbApellidosVacios" Content="Campo obligatorio" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Campo Correo -->
            <Label Content="Correo:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <TextBox x:Name="txtCorreo" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbCorreoVacio" Content="Formato inválido" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Campo Dirección -->
            <Label Content="Dirección:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <TextBox x:Name="txtDireccion" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbDireccionVacia" Content="Campo obligatorio" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Campo Teléfono -->
            <Label Content="Teléfono:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <TextBox x:Name="txtTelefono" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbTelefonoVacio" Content="Campo obligatorio" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Campo Usuario -->
            <Label Content="Usuario:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="5" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <TextBox x:Name="txtUsuario" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbUsuarioVacio" Content="Campo obligatorio" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Campo Contraseña -->
            <Label Content="Contraseña:" Grid.Row="6" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="6" Grid.Column="1">
                <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="5">
                    <PasswordBox x:Name="txtContrasenia" Width="250" Background="Transparent" BorderThickness="0"/>
                </Border>
                <Label x:Name="lbContraseniaVacia" Content="Campo obligatorio" Foreground="Red" 
                       HorizontalAlignment="Right" Visibility="Hidden"/>
            </StackPanel>

            <!-- Botones de acción -->
            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="5">
                <!-- Botón Cancelar -->
                <Button Content="Cancelar" Width="100" Height="30" Margin="10,0" Cursor="Hand" 
                        Click="BtnCancelar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF4C4A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="15"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF9B59B6"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Botón Aceptar -->
                <Button Content="Aceptar" Width="100" Height="30" Margin="10,0" Cursor="Hand" 
                        Click="BtnAceptar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="15"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
