<Page x:Class="LenguaVivaCliente.Vistas.Menu.MenuReportes.MenuReportes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Menu.MenuReportes"
      mc:Ignorable="d" 
      Background="#FF1E1E2E"
      Title="SubMenuReportes">

    <Grid>
        <!-- Encabezado del submenú -->
        <Border Background="#FF8E44AD" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Menú de Reportes" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#FFEDEDED" 
                   FontFamily="Pacifico, cursive"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>
        </Border>

        <!-- Contenedor de botones del submenú -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <!-- Botón Reporte de Profesores -->
            <Border Name="BorderReporteProfesores" CornerRadius="20" Background="#FFD7BDE2" Padding="10" Margin="0,10"
                BorderBrush="#FF9B59B6" BorderThickness="2">
                <Button Content="Reporte de Profesores"
                    Name="BtnReporteProfesores"
                    Click="Click_ReporteProfesores"
                    Background="Transparent" 
                    Foreground="#FF2D3436" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    FontFamily="Segoe UI, sans-serif" 
                    Padding="20,10" 
                    BorderThickness="0" 
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FF2D3436"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFC39BD3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

            <!-- Botón Reporte de Asistencia -->
            <Border CornerRadius="20" Name="BorderReporteAsistencias" Background="#FFE8DAEF" Padding="10" Margin="0,10"
                BorderBrush="#FFA569BD" BorderThickness="2">
                <Button Content="Reporte de Asistencia"
                    Name="BtnReporteAsistencia"
                    Click="Click_ReporteAsistencia"
                    Background="Transparent" 
                    Foreground="#FF2D3436" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    FontFamily="Segoe UI, sans-serif" 
                    Padding="20,10" 
                    BorderThickness="0" 
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FF2D3436"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFD2B4DA"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

            <!-- Botón Reporte de Ingresos -->
            <Border Name="BorderReporteIngresos" CornerRadius="20" Background="#FFD7BDE2" Padding="10" Margin="0,10"
                BorderBrush="#FF9B59B6" BorderThickness="2">
                <Button Content="Reporte de Ingresos"
                    Name="BtnReporteIngresos"
                    Click="Click_ReporteIngresos"
                    Background="Transparent" 
                    Foreground="#FF2D3436" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    FontFamily="Segoe UI, sans-serif" 
                    Padding="20,10" 
                    BorderThickness="0" 
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FF2D3436"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFC39BD3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

            <!-- Botón Reporte de Alumnos -->
            <Border Name="BorderReportesAlumnos" CornerRadius="20" Background="#FFE8DAEF" Padding="10" Margin="0,10"
                BorderBrush="#FFA569BD" BorderThickness="2">
                <Button Content="Reporte de Alumnos"
                    Name="BtnReporteAlumnos"
                    Click="Click_ReporteAlumnos"
                    Background="Transparent" 
                    Foreground="#FF2D3436" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    FontFamily="Segoe UI, sans-serif" 
                    Padding="20,10" 
                    BorderThickness="0" 
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FF2D3436"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFD2B4DA"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

            <!-- Botón Ver mi horario -->
            <Border Name="BorderVerHorario" Visibility="Collapsed" CornerRadius="20" Background="#FFD7BDE2" Padding="10" Margin="0,10"
                BorderBrush="#FF9B59B6" BorderThickness="2">
                <Button Content="Ver mi horario"
                    Name="BtnVerHorario"
                    Visibility="Collapsed"
                    Click="Click_VerHorario"
                    Background="Transparent" 
                    Foreground="#FF2D3436" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    FontFamily="Segoe UI, sans-serif" 
                    Padding="20,10" 
                    BorderThickness="0" 
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#FF2D3436"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFC39BD3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </StackPanel>

        <!-- Botón de Regresar mejorado -->
        <Button HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="10" 
            Cursor="Hand"
            Click="Regresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
                       FontSize="30" 
                       Foreground="White" 
                       FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF8E44AD"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9B59B6"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>
