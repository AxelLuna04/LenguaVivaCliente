<Page x:Class="LenguaVivaCliente.Vistas.Menu.MenuUsuarios.vtUsuariosEncontrados"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Menu.MenuUsuarios"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Usuarios Encontrados"
      Background="#FF1E1E2E">

    <Grid>
        <!-- Encabezado -->
        <Border Background="#FF3498DB" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Usuarios Encontrados" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Botón de regresar -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="BtnRegresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF3498DB"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF5DADE2"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Contenedor principal -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0,20,0,0">
            <!-- ListView para mostrar los resultados -->
            <ListView x:Name="LvUsuarios" 
                      Background="Transparent" 
                      Foreground="#FFEDEDED" 
                      BorderThickness="0"
                      SelectionChanged="ObtenerUsuarioSeleccionado">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="#FF5DADE2" Padding="10" Margin="0,5"
                                Height="40" Width="550">
                            <!-- Tamaño uniforme -->
                            <StackPanel Orientation="Horizontal">
                                <!-- Nombre y correo en la misma línea -->
                                <TextBlock Text="{Binding nombre}" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" | " 
                                           FontSize="16" 
                                           Foreground="#FF2D3436"
                                           VerticalAlignment="Center"
                                           Margin="5,0,5,0"/>
                                <TextBlock Text="{Binding correo}" 
                                           FontSize="16" 
                                           Foreground="#FF2D3436"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
