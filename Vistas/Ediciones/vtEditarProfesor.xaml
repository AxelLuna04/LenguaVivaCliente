<Page x:Class="LenguaVivaCliente.Vistas.Ediciones.vtEditarProfesor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Ediciones"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="Editar Profesor"
      Background="#FF1E1E2E" Height="809">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#FF3498DB" Padding="20">
            <TextBlock Text="Editar Profesor" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Formulario de datos personales (columna izquierda) -->
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">

                <!-- Campo: Nombre -->
                <Label Content="Nombre" Margin="0,0,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox Name="txtNombre" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436"/>
                    </Border>
                    <Label Name="lbNombreVacio" Content="Campo obligatorio" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Campo: Apellidos -->
                <Label Content="Apellidos" Margin="0,5,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox Name="txtApellidos" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436"/>
                    </Border>
                    <Label Name="lbApellidosVacios" Content="Campo obligatorio" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Campo: Correo -->
                <Label Content="Correo" Margin="0,5,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <!-- Se deshabilita para que no se edite el correo -->
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox Name="txtCorreo" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436" IsEnabled="True"/>
                    </Border>
                    <Label x:Name="lbCorreoVacio" Content="Formato inválido" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Campo: Dirección -->
                <Label Content="Dirección" Margin="0,5,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox Name="txtDireccion" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436"/>
                    </Border>
                    <Label Name="lbDireccionVacia" Content="Campo obligatorio" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Campo: Teléfono -->
                <Label Content="Teléfono" Margin="0,5,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox Name="txtTelefono" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436"/>
                    </Border>
                    <Label x:Name="lbTelefonoVacio" Content="Campo obligatorio" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Campo: Usuario -->
                <Label Content="Usuario" Margin="0,5,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <!-- Se deshabilita para que no se edite el usuario -->
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox Name="txtUsuario" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436" IsEnabled="True"/>
                    </Border>
                    <Label Name="lbUsuarioVacio" Content="Campo obligatorio" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Campo: Contraseña -->
                <Label Content="Contraseña" Margin="0,5,0,2" Foreground="White"/>
                <StackPanel Orientation="Vertical" Margin="0,0,0,5">
                    <!-- Se deja en blanco si no se desea cambiar -->
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <PasswordBox Name="txtContraseña" Width="300" Background="Transparent" BorderThickness="0" Foreground="#FF2D3436"/>
                    </Border>
                    <Label Name="lbContraseniaVacia" Content="Mínimo 8 caracteres si desea cambiar" Foreground="Red" Visibility="Hidden"/>
                </StackPanel>

                <!-- Botones de acción -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Cancelar" 
                            Width="100" 
                            Height="35" 
                            Margin="5" 
                            Background="#FF4C4A" 
                            Foreground="White" 
                            Cursor="Hand"
                            Click="BtnCancelar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF4C4A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#9B59B6"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Guardar" 
                            Width="100" 
                            Height="35" 
                            Margin="5" 
                            Background="#4CAF50" 
                            Foreground="White" 
                            Cursor="Hand"
                            Click="BtnGuardar_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2E7D32"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- (Opcional: Agregar sección para idiomas dominados, similar al registro) -->
            <!-- Sección para idiomas dominados (columna derecha) -->
            <GroupBox Grid.Column="2" Header="Idiomas que domina" Padding="10" 
          FontFamily="Segoe UI, sans-serif" Foreground="White" BorderBrush="#FF3498DB"
          VerticalAlignment="Stretch">
                <Border CornerRadius="10" Background="#FFEDEDED" Padding="5" BorderBrush="#FF2980B9" BorderThickness="2">
                    <DataGrid Name="dataGridIdiomas" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Single" 
                  IsReadOnly="False"
                  Background="Transparent"
                  Foreground="#FF2D3436"
                  BorderThickness="0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HeadersVisibility="Column"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Seleccionar" Binding="{Binding IsSelected}" Width="Auto"/>
                            <DataGridTextColumn Header="Idioma" Binding="{Binding nombreIdioma}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </GroupBox>

        </Grid>
    </Grid>
</Page>
