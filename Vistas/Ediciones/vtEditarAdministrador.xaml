<Page x:Class="LenguaVivaCliente.Vistas.Ediciones.vtEditarAdministrador"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Ediciones"
      mc:Ignorable="d"
      Title="Editar Administrador"
      Background="#FF1E1E2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Border Grid.Row="0" Background="#FF3498DB" Padding="20">
            <TextBlock Text="Editar Administrador"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#FFEDEDED"
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Contenedor del formulario centrado y no tan ancho -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="#FF1E1E2E" Padding="20">
                <StackPanel Orientation="Vertical" Width="350" HorizontalAlignment="Center">

                    <!-- Campo: Nombre -->
                    <TextBlock Text="Nombre" Margin="0,0,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox x:Name="txtNombre" Width="250" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbNombreVacio" Text="Campo obligatorio" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Campo: Apellidos -->
                    <TextBlock Text="Apellidos" Margin="10,10,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox x:Name="txtApellidos" Width="250" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbApellidosVacios" Text="Campo obligatorio" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Campo: Correo -->
                    <TextBlock Text="Correo" Margin="10,10,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox x:Name="txtCorreo" Width="250" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbCorreoVacio" Text="Formato inválido" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Campo: Dirección -->
                    <TextBlock Text="Dirección" Margin="10,10,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox x:Name="txtDireccion" Width="250" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbDireccionVacia" Text="Campo obligatorio" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Campo: Teléfono -->
                    <TextBlock Text="Teléfono" Margin="10,10,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox x:Name="txtTelefono" Width="250" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbTelefonoVacio" Text="Campo obligatorio" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Campo: Usuario -->
                    <TextBlock Text="Usuario" Margin="10,10,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,2">
                        <TextBox x:Name="txtUsuario" Width="250" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbUsuarioVacio" Text="Campo obligatorio" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Campo: Contraseña -->
                    <TextBlock Text="Contraseña" Margin="10,10,0,5" Foreground="White"/>
                    <Border CornerRadius="10" Background="#FF5DADE2" Padding="5" Margin="0,0,0,20">
                        <PasswordBox x:Name="txtContrasenia" Width="250" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Left" Foreground="#FF2D3436"/>
                    </Border>
                    <TextBlock x:Name="lbContraseniaVacia" Text="Campo obligatorio" Foreground="Red" 
                               FontSize="12" Visibility="Hidden" HorizontalAlignment="Right"/>

                    <!-- Botones de acción -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancelar" Width="100" Height="35" Margin="10"
                                Background="#FF4C4A" Foreground="White" Cursor="Hand"
                                Click="BtnCancelar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF4C4A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#9B59B6"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Aceptar" Width="100" Height="35" Margin="10"
                                Background="#4CAF50" Foreground="White" Cursor="Hand"
                                Click="BtnAceptar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#4CAF50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
