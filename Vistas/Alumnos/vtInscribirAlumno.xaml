<Page x:Class="LenguaVivaCliente.Vistas.Alumnos.vtInscribirAlumno"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Alumnos"
      mc:Ignorable="d" 
      MinHeight="500"
      MinWidth="500"
      d:DesignHeight="500" d:DesignWidth="500"
      Title=""
    Background="#FF1E1E2E">

    <Page.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2ECC71"/>
            <Setter Property="Foreground" Value="#FF2D3436"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="20"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF58D68D"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        

    </Page.Resources>
    
    <Grid>
        <!-- Encabezado del submenú -->
        <Border Background="#FF8E44AD" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Inscribir Alumno" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Contenedor de botones del submenú -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            <TextBlock Text="Busque el nombre del alumno y el curso al que lo quiere inscribir:" 
                   Width="400"
                   TextWrapping="Wrap"
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#FFEDEDED" 
                   FontFamily="Pacifico, cursive"
                   HorizontalAlignment="Stretch"
                   Margin="0,0,0,10"/>
            <!-- Botón Registrar Usuarios -->
            <Grid>
                <Label Content="Alumo" Margin="0,0,250,0"
           FontSize="28" 
           FontWeight="Bold" 
           Foreground="#FFEDEDED" 
           FontFamily="Pacifico, cursive"
           HorizontalAlignment="Center"/>
                <Label Content="Curso" Margin="250,0,0,0"
           FontSize="28" 
           FontWeight="Bold" 
           Foreground="#FFEDEDED" 
           FontFamily="Pacifico, cursive"
           HorizontalAlignment="Center"/>
                
            </Grid>
            <Grid>
                <TextBox x:Name="tbAlumno" Margin="0,0,250,0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200"
                 Height="28" 
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 BorderBrush="#FF9B59B6"
                 Background="#FFF4ECF7"
                 Padding="5"
                 TextChanged="tbAlumno_TextChanged" 
                 MaxLength="50"/>
                <TextBox x:Name="tbCurso" Margin="250,0,0,0" HorizontalAlignment="Center" Width="200"
                Height="28" 
                FontSize="14" 
                VerticalContentAlignment="Center"
                BorderBrush="#FF9B59B6"
                Background="#FFF4ECF7"
                Padding="5"
                TextChanged="tbCurso_TextChanged" 
                MaxLength="50"/>
            </Grid>
            <Grid Margin="0,20,0,100">
                <ComboBox x:Name="cbAlumnos" Width="200" Height="28" FontSize="16" Margin="0,0,250,0"
                          VerticalContentAlignment="Center" BorderBrush="#FF9B59B6" Background="#FFD7BDE2">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding nombre}" />
                                <TextBlock Text=" " />
                                <TextBlock Text="{Binding apellidos}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="cbCursos" Width="200" Height="28" FontSize="16" Margin="250,0,0,0" 
          VerticalContentAlignment="Center" BorderBrush="#FF9B59B6" Background="#FFD7BDE2" >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding nombreCurso}" />
                                <TextBlock Text=" | " />
                                <TextBlock Text="{Binding fechaInicio}" />
                                <TextBlock Text=" - " />
                                <TextBlock Text="{Binding fechaTermino}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Button x:Name="btnInscribir" Content="Inscribir" HorizontalAlignment="Center"  VerticalAlignment="Bottom" Width="200" Height="40" Click="BtnInscribir_Click"/>

            


        </StackPanel>

        <!-- Botón de Regresar mejorado -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="Regresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF8E44AD"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9B59B6"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>