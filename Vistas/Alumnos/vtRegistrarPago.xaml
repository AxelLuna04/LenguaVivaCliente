<Window x:Class="LenguaVivaCliente.Vistas.Alumnos.vtRegistrarPago"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:LenguaVivaCliente.Properties"
        xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Alumnos"
        mc:Ignorable="d"
        Title="RegistrarPago" 
        Height="770" Width="1200" 
        WindowState="Normal" 
        ResizeMode="NoResize" 
        WindowStyle="None" 
        WindowStartupLocation="CenterOwner" 
        Background="#1A1B26" 
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Estilo mejorado para el TextBox con máximo contraste -->
        <Style TargetType="{x:Type TextBox}">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="BorderBrush" Value="#7AA2F7" />
                </Style>
            </Style.Resources>
            <Setter Property="Background" Value="#FFFFFF"/>
            <!-- Fondo blanco puro para máximo contraste -->
            <Setter Property="Foreground" Value="#1A1B26"/>
            <!-- Texto oscuro -->
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="22"/>
            <!-- Tamaño de fuente aumentado -->
            <Setter Property="Padding" Value="15"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#7AA2F7"/>
            <Setter Property="SelectionBrush" Value="#7AA2F766"/>
            <!-- Color de selección semitransparente -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7AA2F7" BlurRadius="10" Opacity="0.3" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#1A1B26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Titan One"/>
            <Setter Property="FontSize" Value="24"/>
            <!-- Tamaño de fuente aumentado -->
            <Setter Property="Padding" Value="25,12"/>
            <!-- Más padding para mejor aspecto -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7AA2F7" BlurRadius="15" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1A1B26"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#7AA2F7" BlurRadius="20" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="10" />
                    <!-- Esquinas más redondeadas -->
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Fill">
        <Grid Height="770" Width="1200">
            <!-- Panel principal con gradiente sutil -->
            <Border Margin="320,80,320,100" CornerRadius="16" Background="#24283B">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.3"/>
                </Border.Effect>
            </Border>

            <!-- Título con gradiente azul -->
            <Label FontFamily="Titan One"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   FontSize="64"
                   Margin="0,110,0,0"
                   Height="100"
                   Content="Registrar pago">
                <Label.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7AA2F7" Offset="0"/>
                        <GradientStop Color="#BB9AF7" Offset="1"/>
                    </LinearGradientBrush>
                </Label.Foreground>
                <Label.Effect>
                    <DropShadowEffect Color="#7AA2F7" BlurRadius="10" Opacity="0.4"/>
                </Label.Effect>
            </Label>

            <!-- Línea decorativa más gruesa -->
            <Rectangle Width="500" Height="4" Fill="#7AA2F7" HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,190,0,0" RadiusX="2" RadiusY="2" Opacity="0.8"/>

            <!-- Instrucción con mejor formato -->
            <TextBlock Text="Ingrese la cantidad que ha sido pagada" 
                       Margin="400,240,400,0" TextWrapping="Wrap" VerticalAlignment="Top" 
                       Height="60" FontFamily="Inter" FontSize="20"
                       Foreground="#A9B1D6" HorizontalAlignment="Center" TextAlignment="Center"
                       FontWeight="SemiBold"/>

            <!-- Campo de cantidad - Ahora con etiqueta centrada -->
            <Label FontFamily="Titan One" HorizontalAlignment="Left" VerticalAlignment="Top" 
                   FontSize="26" Foreground="#7AA2F7" Content="Cantidad:" Margin="403,320,0,0"/>

            <!-- Campo de texto destacado -->
            <TextBox x:Name="tbCantidadPagada" VerticalContentAlignment="Center" 
                     Margin="0,362,0,0" Height="70" VerticalAlignment="Top"
                     Width="400" HorizontalAlignment="Center"/>
            <!-- Ancho fijo y centrado -->

            <!-- Botón más grande y destacado -->
            <Button Content="Registrar pago" Click="BtnRegistrarPago_Click" Name="BtnRegistrarPago"
                    Margin="0,460,0,0" VerticalAlignment="Top" Height="57" Width="234"
                    HorizontalAlignment="Center">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#73DACA" Offset="0"/>
                        <GradientStop Color="#41B38A" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#8CE6D8" Offset="0"/>
                                            <GradientStop Color="#5ACCA4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Nuevo botón en la parte inferior derecha -->
            <Button Content="Recibo de pago" 
                    Name="BtnReciboDePago"
                    Click="BtnReciboDePago_Click"
                    Visibility="Collapsed"
                    Margin="0,0,340,120" 
                    VerticalAlignment="Bottom" 
                    Height="57" 
                    Width="234"
                    HorizontalAlignment="Right">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7AA2F7" Offset="0"/>
                        <GradientStop Color="#BB9AF7" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9AB7FF" Offset="0"/>
                                            <GradientStop Color="#CCB2FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Detalle decorativo inferior más ancho -->
        </Grid>
    </Viewbox>
</Window>
