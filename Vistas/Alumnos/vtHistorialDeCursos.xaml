<Page x:Class="LenguaVivaCliente.Vistas.Alumnos.vtHistorialDeCursos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Alumnos"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Historial de Cursos"
      Background="#FF1E1E2E">

    <Grid>
        <!-- Encabezado -->
        <Border Background="#FF3498DB" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Historial de Cursos" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Botón de regresar -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="BtnRegresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF3498DB"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF5DADE2"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Contenedor principal -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="0,20,0,0">
            <!-- ListView para mostrar los resultados -->
            <ListView x:Name="LvCursos" 
                      Background="Transparent" 
                      Foreground="#FFEDEDED" 
                      BorderThickness="0"
                      SelectionChanged="ObtenerCursoSeleccionado"
                      Height="300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Background="#FF5DADE2" Padding="10" Margin="0,5"
                                Height="80" Width="550">
                            <StackPanel Orientation="Vertical">
                                <!-- Primera línea: Nombre del curso | Nombre del profesor -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Curso: "
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding nombreCurso}" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" | Profesor: " 
                                               FontSize="16" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"
                                               Margin="5,0,5,0"/>
                                    <TextBlock Text="{Binding nombreProfesor}" 
                                               FontSize="16" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Segunda línea: Fecha inicio: | Fecha Fin: -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fecha inicio: " 
                                               FontSize="14" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding fechaInicio}" 
                                               FontSize="14" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>

                                    <TextBlock Text=" | " 
                                               FontSize="14" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"
                                               Margin="5,0,5,0"/>

                                    <TextBlock Text="Fecha fin: " 
                                               FontSize="14" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding fechaTermino}" 
                                               FontSize="14" 
                                               Foreground="#FF2D3436"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Botón de Recibo de Pago -->
            <Button x:Name="BtnReciboPago" 
                    Content="Recibo de Pago" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0" 
                    Padding="15,10" 
                    FontSize="18" 
                    FontWeight="Bold" 
                    Foreground="White"
                    Cursor="Hand"
                    Click="BtnReciboPago_Click"
                    IsEnabled="{Binding ElementName=LvCursos, Path=SelectedItems.Count}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF27AE60"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2ECC71"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FF95A5A6"/>
                                <Setter Property="Foreground" Value="#FF7F8C8D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Page>
