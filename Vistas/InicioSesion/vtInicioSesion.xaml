<Page x:Class="LenguaVivaCliente.Vistas.InicioSesion.vtInicioSesion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.InicioSesion"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vtInicioSesion">

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="LightSteelBlue" />
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="150">
            <TextBlock FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="Black">
            <Run Language="es-mx" Text="Lengua Viva"/>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="400" MinWidth="300">

                <Label Content="Correo"
                   HorizontalAlignment="Left"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,5,0,0"/>
                <TextBox x:Name="tbUsuario"
                     Text="Correo"
                     Tag="Correo"
                     Margin="0,10"
                     Padding="10"
                     Background="Transparent"
                     Height="40"
                     FontSize="16"
                     Foreground="Black" />

                <Label Content="Contrasena"
                   HorizontalAlignment="Left"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,10,0,0"/>
                <PasswordBox x:Name="tpContraseña"
                         Margin="0,10"
                         Padding="10"
                         Tag="************"
                         Height="40"
                         FontSize="16"
                         Password=""
                         Background="Transparent"

                         BorderBrush="Transparent"
                         Foreground="Black" />
                <Label x:Name="lbCredencialesIncorrectas" 
                   Content="Credenciales incorrectas" 
                   Visibility="Collapsed" 
                   FontFamily="Inter" 
                   FontSize="14" 
                   VerticalContentAlignment="Center" 
                   HorizontalContentAlignment="Center" 
                   Foreground="#FFFF5959" 
                   Height="28" Width="204"/>
                <Button Content="Inicio de sesion"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    Margin="0,20,0,0"
                    Padding="10"
                    Height="40" 
                    Click="BtnIniciarSesion_Click"/>
                <TextBlock FontFamily="Inter" 
                       FontSize="14" 
                       VerticalAlignment="Top" 
                       Foreground="PowderBlue" 
                       Cursor="Hand" 
                       Text="Olvide mi contrasena"
                       Name="BtnRecuperarContraseña"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>

                <Button Content="Registrarse"
                    HorizontalAlignment="Center" 
                    Margin="0,16,0,0" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    VerticalAlignment="Top" 
                    Height="32" 
                    Width="88"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

            </StackPanel>
            <Button x:Name="BtnInvitado" Content="Invitado" 
                    HorizontalAlignment="Left" 
                    FontWeight="Bold" 
                    FontSize="16" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Margin="403,0,0,0" />
            <TextBox Name="tbInvitado" HorizontalAlignment="Left" Margin="595,5,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        </Grid>
        <ComboBox x:Name="cbIdioma"
                      Margin="992,59,58,57">
            <ComboBoxItem Content="Español" Tag="es-MX" />
            <ComboBoxItem Content="English" Tag="en-US" />
        </ComboBox>
    </Grid>
</Page>
