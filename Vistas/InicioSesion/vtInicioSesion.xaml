<Page x:Class="LenguaVivaCliente.Vistas.InicioSesion.vtInicioSesion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.InicioSesion"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Inicio de Sesión"
      Background="#FF1E1E2E">

    <Page.Resources>
        <!-- Easing function para la animación de temblor -->
        <ElasticEase x:Key="ElasticEase" Oscillations="2" Springiness="3"/>

        <!-- Animación para desvanecer el mensaje -->
        <Storyboard x:Key="FadeOutStoryboard" AutoReverse="False">
            <DoubleAnimation
                Storyboard.TargetName="lbCredencialesIncorrectas"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:2" />
        </Storyboard>

        <!-- Animación de temblor -->
        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="-10" EasingFunction="{StaticResource ElasticEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="8" EasingFunction="{StaticResource ElasticEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-6" EasingFunction="{StaticResource ElasticEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="4" EasingFunction="{StaticResource ElasticEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-2" EasingFunction="{StaticResource ElasticEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" EasingFunction="{StaticResource ElasticEase}"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1E1E2E" Offset="0"/>
                <GradientStop Color="#FF2C3E50" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#FF34495E" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Lengua Viva" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF"
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <StackPanel.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </StackPanel.RenderTransform>

            <Border CornerRadius="10" Background="#FFECF0F1" Padding="10" Margin="0,10">
                <Grid>
                    <TextBox x:Name="tbUsuario"
                             FontSize="16"
                             Foreground="#2C3E50"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             TextChanged="tbUsuario_TextChanged"/>
                    <TextBlock x:Name="tbUsuarioPlaceholder"
                               Text="Correo"
                               FontSize="16"
                               Foreground="#95A5A6"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border CornerRadius="10" Background="#FFECF0F1" Padding="10" Margin="0,10">
                <Grid>
                    <!-- PasswordBox (oculto cuando se muestra el texto) -->
                    <PasswordBox x:Name="tpContraseña"
                     FontSize="16"
                     Foreground="#2C3E50"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     PasswordChanged="tpContraseña_PasswordChanged"
                     Visibility="Visible"/>

                    <!-- TextBox para mostrar texto (oculto inicialmente) -->
                    <TextBox x:Name="tbContraseñaVisible"
                             FontSize="16"
                             Foreground="#2C3E50"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             TextChanged="tbContraseñaVisible_TextChanged"/>

                    <TextBlock x:Name="tpContraseñaPlaceholder"
                               Text="Contraseña"
                               FontSize="16"
                               Foreground="#95A5A6"
                               VerticalAlignment="Center"
                               Margin="10,0,30,0"
                               IsHitTestVisible="False"/>

                    <!-- Botón del ojito -->
                    <Button x:Name="btnTogglePassword"
                            Width="24" Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="btnTogglePassword_Click">
                        <Image x:Name="EyeIcon"
                               Source="/ImagenesProyecto/eye_show.png" 
                               Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Mensaje de credenciales incorrectas -->
            <TextBlock x:Name="lbCredencialesIncorrectas" 
                       Text="Credenciales incorrectas" 
                       Visibility="Collapsed" 
                       FontSize="14" 
                       Foreground="#E74C3C"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- Botón de inicio de sesión -->
            <Button x:Name="BtnIniciarSesion"
                    Content="Iniciar Sesión"
                    Background="#FF2ECC71"
                    Foreground="#FFFFFF"
                    FontSize="16"
                    FontWeight="Bold"
                    Padding="15,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    Click="BtnIniciarSesion_Click" Width="174" Height="39">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#FF2ECC71"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Page>
