<Page x:Class="LenguaVivaCliente.Vistas.InicioSesion.vtInicioSesion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.InicioSesion"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Inicio de Sesión"
      Background="#FF1E1E2E">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1E1E2E" Offset="0"/>
                <GradientStop Color="#FF2C3E50" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Background="#FF34495E" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Lengua Viva" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF"
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <Border CornerRadius="10" Background="#FFECF0F1" Padding="10" Margin="0,10">
                <Grid>
                    <TextBox x:Name="tbUsuario"
                             FontSize="16"
                             Foreground="#2C3E50"
                        Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             TextChanged="tbUsuario_TextChanged"/>
                        <TextBlock x:Name="tbUsuarioPlaceholder"
                               Text="Correo"
                               FontSize="16"
                               Foreground="#95A5A6"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border CornerRadius="10" Background="#FFECF0F1" Padding="10" Margin="0,10">
                <Grid>
                    <PasswordBox x:Name="tpContraseña"
                                 FontSize="16"
                                 Foreground="#2C3E50"
                        Background="Transparent"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 PasswordChanged="tpContraseña_PasswordChanged"/>
                        <TextBlock x:Name="tpContraseñaPlaceholder"
                               Text="Contraseña"
                               FontSize="16"
                               Foreground="#95A5A6"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Mensaje de credenciales incorrectas -->
            <TextBlock x:Name="lbCredencialesIncorrectas" 
                       Text="Credenciales incorrectas" 
                       Visibility="Collapsed" 
                       FontSize="14" 
                       Foreground="#E74C3C"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- Botón de inicio de sesión -->
            <Button x:Name="BtnIniciarSesion"
                    Content="Iniciar Sesión"
                    Background="#FF2ECC71"
                    Foreground="#FFFFFF"
                    FontSize="16"
                    FontWeight="Bold"
                    Padding="15,10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Stretch"
                    Click="BtnIniciarSesion_Click" Width="174" Height="39">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="20"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="#FFFFFF"/> <!-- Blanco -->
                        <Setter Property="Background" Value="#FF2ECC71"/> <!-- Verde -->
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#27AE60"/> <!-- Verde más oscuro -->
                                <Setter Property="Foreground" Value="#FFFFFF"/> <!-- Blanco -->
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Page>