<Page x:Class="LenguaVivaCliente.Vistas.Cursos.vtRegistrarIdioma"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Cursos"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vtRegistrarIdioma">

    <Grid Background="#FF1E1E2E">
        <!-- Encabezado -->
        <Border Background="#3bb971" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Registrar Idioma" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Botón de volver -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="Click_Volver">
            <Button.Content>
                <TextBlock Text="⬅️" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#3bb971"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9B59B6"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Contenido principal -->
        <StackPanel Margin="60,100,60,60">
            <Label Content="Nombre del Idioma:" FontSize="18" Foreground="White"/>
            <TextBox x:Name="tbNombreIdioma"
                     Height="40"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     BorderBrush="#FF9B59B6"
                     Background="#FFF4ECF7"
                     Padding="5"
                     MaxLength="50"/>
            <Label x:Name="lbNombreVacio"
                   Content="¡El campo no puede estar vacío!"
                   FontSize="12"
                   Foreground="#FFE74C3C"
                   Visibility="Hidden"
                   Margin="0,5,0,0"/>

            <!-- Botón de guardar -->
            <Button Content="Registrar Idioma"
                    Width="200"
                    Height="50"
                    FontSize="18"
                    Background="#3bb971"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Margin="0,30,0,0"
                    Click="Click_RegistrarIdioma">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF9B59B6"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Page>
