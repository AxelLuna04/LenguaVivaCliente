<Page x:Class="LenguaVivaCliente.Vistas.Cursos.vtAsignarHorario"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Cursos"
      mc:Ignorable="d" 
            MinHeight="500"
      MinWidth="700"
      d:DesignHeight="500" d:DesignWidth="800"
      Title=""
    Background="#FF1E1E2E">

    <Page.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2ECC71"/>
            <Setter Property="Foreground" Value="#FF2D3436"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="20"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF58D68D"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>


    </Page.Resources>

    <Grid>
        <!-- Encabezado del submenú -->
        <Border Background="#FF8E44AD" Padding="20" VerticalAlignment="Top">
            <TextBlock Text="Asignar Horario" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#FFEDEDED" 
                       FontFamily="Pacifico, cursive"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Contenedor de botones del submenú -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="750">
            <!-- Botón Registrar Usuarios -->
            <Grid>
                <Label Content="Hora de inicio" Margin="0,0,500,0"
                       Width="200"
           FontSize="28" 
           FontWeight="Bold" 
           Foreground="#FFEDEDED" 
           FontFamily="Pacifico, cursive"
           HorizontalAlignment="Center"/>
                <Label Content="Hora de Término" Margin="0,0,0,0"
           FontSize="28" 
           FontWeight="Bold" 
           Foreground="#FFEDEDED" 
           FontFamily="Pacifico, cursive"
           HorizontalAlignment="Center"/>
                <Label Content="Día" Margin="500,0,0,0"
            FontSize="28" 
            FontWeight="Bold" 
            Foreground="#FFEDEDED" 
            FontFamily="Pacifico, cursive"
            HorizontalAlignment="Center"/>

            </Grid>
            <Grid/>
            <Grid Margin="0,20,0,0" HorizontalAlignment="Center">
                <ComboBox x:Name="cbHoraInicio" Width="200" Height="28" FontSize="16" Margin="0,0,500,0"
                          VerticalAlignment="Top"
                          VerticalContentAlignment="Center" BorderBrush="#FF9B59B6" Background="#FFD7BDE2" SelectionChanged="cbHoraInicio_SelectionChanged"
                          DisplayMemberPath="HoraFormateada">
                </ComboBox>
                <ComboBox x:Name="cbHoraTermino" Width="200" Height="28" FontSize="16" Margin="0,0,0,0" 
                          VerticalAlignment="Top" IsEnabled="False"
          VerticalContentAlignment="Center" BorderBrush="#FF9B59B6" Background="#FFD7BDE2" Grid.ColumnSpan="2" 
                          DisplayMemberPath="HoraFormateada">
                </ComboBox>
                <Grid x:Name="gRadioButtons" Margin="500,0,0,0" HorizontalAlignment="Center">
                    <RadioButton x:Name="rbLunes" Content="Lunes" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                    <RadioButton x:Name="rbMartes" Content="Martes" Margin="0,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                    <RadioButton x:Name="rbMiercoles" Content="Miércoles" Margin="0,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                    <RadioButton x:Name="rbJueves" Content="Jueves" Margin="0,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                    <RadioButton x:Name="rbViernes" Content="Viernes" Margin="0,120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                    <RadioButton x:Name="rbSabado" Content="Sábado" Margin="0,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                    <RadioButton x:Name="rbDomingo" Content="Domingo" Margin="0,180,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" Height="28" Foreground="#FFEDEDED" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </Grid>
            <Button x:Name="btnAsignar" Content="Asignar" HorizontalAlignment="Center"  VerticalAlignment="Bottom" Width="200" Height="40" Click="BtnAsignar_Click"/>




        </StackPanel>

        <!-- Botón de Regresar mejorado -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="Regresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF8E44AD"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9B59B6"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Page>