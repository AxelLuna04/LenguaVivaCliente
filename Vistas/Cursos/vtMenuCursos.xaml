<Page x:Class="LenguaVivaCliente.Vistas.Cursos.vtMenuCursos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Cursos"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="vtMenuCursos">

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="White" />
        </Grid.Background>
        <Button Content="Registrar" HorizontalAlignment="Center" Margin="0,123,0,0" VerticalAlignment="Top" Click="Click_Registrar"/>
        <Button Content="Buscar" HorizontalAlignment="Center" Margin="0,170,0,0" VerticalAlignment="Top" Click="Click_Buscar"/>
        <Button Content="Editar" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Click_Editar"/>
        <Button Content="info" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Click_info" Margin="0,260,0,0"/>
    </Grid>
</Page>
