<Page x:Class="LenguaVivaCliente.Vistas.Cursos.ReportesCurso.vtReporteDeIngresos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:LenguaVivaCliente.Vistas.Cursos"
      mc:Ignorable="d" 
      Title="Ingresos generados"
      Height="450" Width="600"
      Background="#FF1E1E2E">

    <Page.Resources>
        <!-- Estilos para etiquetas y campos de texto -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#333333"/>
            <!-- Cambiado a color oscuro -->
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10 5 5 5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <!-- Cambiado a color oscuro -->
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="TotalLabelStyle" BasedOn="{StaticResource {x:Type Label}}" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF8E44AD"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Botón de Regresar -->
        <Button HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Margin="10" 
                Cursor="Hand"
                Click="Regresar_Click">
            <Button.Content>
                <TextBlock Text="⬅️" 
                           FontSize="30" 
                           Foreground="White" 
                           FontFamily="Segoe UI Symbol"/>
            </Button.Content>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF8E44AD"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF9B59B6"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Contenedor principal -->
        <Border Background="White" Margin="40,60,40,40" CornerRadius="5" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Border Grid.Row="0" Background="#3F51B5" CornerRadius="5 5 0 0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="INGRESOS GENERADOS" 
                                   Foreground="White" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Lengua Viva" 
                                   Foreground="White" 
                                   FontSize="16" 
                                   HorizontalAlignment="Center"
                                   Margin="0 5 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Contenido -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Campos del formulario -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Curso:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="txtCurso"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Fecha inicio:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="txtFechaInicio"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Fecha fin:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Name="txtFechaFin"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Alumnos inscritos:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Name="txtAlumnosInscritos"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Total de ingresos:" Style="{StaticResource TotalLabelStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Name="txtTotalIngresos" FontWeight="Bold" FontSize="16" BorderBrush="#FF8E44AD" BorderThickness="0 0 0 2"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>